<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>heic2jpeg</AssemblyName>
    <!-- Lets the tool run on a newer .NET runtime if the exact major version is not installed. -->
    <RollForward>Major</RollForward>
    <!-- Overridden by CI from the git tag: dotnet pack/publish -p:Version=1.2.3 -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- NuGet package, installable with: dotnet tool install -g heic2jpeg -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>heic2jpeg</ToolCommandName>
    <PackageId>heic2jpeg</PackageId>
    <Authors>Piotr Zarek</Authors>
    <Description>Converts a folder of HEIC/HEIF photos to JPEG in parallel, with progress bars.</Description>
    <PackageTags>heic;heif;jpeg;jpg;convert;converter;images;photos;iphone;cli;tool</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/pzarek/heic2jpeg</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pzarek/heic2jpeg</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!-- Self-contained single-file binaries for GitHub Releases: dotnet publish -c Release -r <rid> -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
  </ItemGroup>

</Project>
